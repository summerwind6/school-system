<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.system.mapper.CourseScheduleMapper">
    <resultMap id="BaseResultMap" type="com.school.system.entity.CourseSchedule">
        <id column="id" property="id"/>
        <result column="course_id" property="courseId"/>
        <result column="day_of_week" property="dayOfWeek"/>
        <result column="start_section" property="startSection"/>
        <result column="end_section" property="endSection"/>
        <result column="start_week" property="startWeek"/>
        <result column="end_week" property="endWeek"/>
        <result column="week_type" property="weekType"/>
        <result column="classroom" property="classroom"/>
    </resultMap>

    <select id="selectByCourseId" resultMap="BaseResultMap">
        SELECT id, course_id, day_of_week, start_section, end_section,
               start_week, end_week, week_type, classroom
        FROM course_schedule
        WHERE course_id = #{courseId}
        ORDER BY day_of_week, start_week, start_section
    </select>
</mapper>
